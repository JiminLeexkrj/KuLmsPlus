{
  "manifest_version": 3,
  "name": "KU LMS+ 캘린더",
  "version": "1.0.0",
  "description": "고려대 LMS의 과제, 퀴즈, 온라인 강의 출석·지각·열람 기간을 한 캘린더에 모아 보여줍니다. (비공식)",
  "permissions": ["cookies", "storage"],
  "host_permissions": ["https://mylms.korea.ac.kr/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "KU LMS+ 캘린더 열기",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
